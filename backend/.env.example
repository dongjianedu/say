# 服务器配置
HOST=0.0.0.0
PORT=8000

# 转录服务配置（以 OpenAI Whisper 为例）
TRANSCRIBE_API_KEY=your-openai-api-key
TRANSCRIBE_API_URL=https://api.openai.com/v1/audio/transcriptions

# 摘要服务配置（以 OpenAI Chat 为例）
SUMMARIZE_API_KEY=your-openai-api-key
SUMMARIZE_API_URL=https://api.openai.com/v1/chat/completions

# 其他云服务示例（阿里云）
# TRANSCRIBE_API_URL=https://nls-gateway.cn-shanghai.aliyuncs.com/stream/v1/FlashRecognizer
# SUMMARIZE_API_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation
